/*
==================================================
ADD LANGUAGE OPTIONS
==================================================
*/

const select =
  document.getElementById("languageSelect");

Object.keys(languages).forEach(code => {

  const option =
    document.createElement("option");

  option.value = code;
  option.textContent =
    languages[code].name;

  select.appendChild(option);

});


/*
==================================================
CURRENT LANGUAGE
==================================================
*/

let currentLanguage = "hi";

let lang = languages[currentLanguage];


/*
==================================================
CHANGE LANGUAGE
==================================================
*/

function changeLanguage() {

  currentLanguage =
    select.value;

  lang =
    languages[currentLanguage];

  document.documentElement.lang =
    currentLanguage;

  updateUI();

}


/*
==================================================
UPDATE UI
==================================================
*/

function updateUI() {

  document.getElementById("title")
    .innerHTML = lang.title;

  document.getElementById("subtitle")
    .innerHTML = lang.subtitle;

  document.getElementById("voiceStatus")
    .innerHTML = lang.voice;

  document.getElementById("textInput")
    .placeholder = lang.placeholder;

  document.getElementById("sendButton")
    .innerHTML = lang.send;

  document.getElementById("schemeTitle")
    .innerHTML = lang.schemeTitle;

  document.getElementById("schemeName")
    .innerHTML = lang.schemeName;

  document.getElementById("schemeDescription")
    .innerHTML = lang.schemeDescription;

  document.getElementById("whoTitle")
    .innerHTML = lang.whoTitle;

  document.getElementById("whoText")
    .innerHTML = lang.whoText;

  document.getElementById("benefitTitle")
    .innerHTML = lang.benefitTitle;

  document.getElementById("benefitText")
    .innerHTML = lang.benefitText;

  document.getElementById("documentTitle")
    .innerHTML = lang.documentTitle;

  document.getElementById("documentText")
    .innerHTML = lang.documentText;

  document.getElementById("applyButton")
    .innerHTML = lang.apply;

  document.getElementById("stepsTitle")
    .innerHTML = lang.stepsTitle;

  document.getElementById("stepsDescription")
    .innerHTML = lang.stepsDescription;

  document.getElementById("step1Title")
    .innerHTML = lang.step1Title;

  document.getElementById("step1Text")
    .innerHTML = lang.step1Text;

  document.getElementById("step2Title")
    .innerHTML = lang.step2Title;

  document.getElementById("step2Text")
    .innerHTML = lang.step2Text;

  document.getElementById("step3Title")
    .innerHTML = lang.step3Title;

  document.getElementById("step3Text")
    .innerHTML = lang.step3Text;

  document.getElementById("step4Title")
    .innerHTML = lang.step4Title;

  document.getElementById("step4Text")
    .innerHTML = lang.step4Text;

  document.getElementById("step5Title")
    .innerHTML = lang.step5Title;

  document.getElementById("step5Text")
    .innerHTML = lang.step5Text;

  document.getElementById("websiteButton")
    .innerHTML = lang.website;

  document.getElementById("completeButton")
    .innerHTML = lang.complete;

  document.getElementById("successTitle")
    .innerHTML = lang.successTitle;

  document.getElementById("successText")
    .innerHTML = lang.successText;

  renderWelcome();

}


/*
==================================================
WELCOME MESSAGE
==================================================
*/

function renderWelcome() {

  const chat =
    document.getElementById("chat");

  chat.innerHTML = "";

  addMessage(
    lang.welcome,
    "assistant",
    false
  );

}


/*
==================================================
ADD MESSAGE
==================================================
*/

function addMessage(
  text,
  sender = "assistant",
  shouldSpeak = true
) {

  const message =
    document.createElement("div");

  message.className =
    "message " + sender;

  const bubble =
    document.createElement("div");

  bubble.className =
    "bubble";

  bubble.innerHTML =
    text;

  message.appendChild(bubble);

  document.getElementById("chat")
    .appendChild(message);

  document.getElementById("chat")
    .scrollTop =
    document.getElementById("chat").scrollHeight;

  if (
    sender === "assistant" &&
    shouldSpeak
  ) {

    speak(
      text.replace(/<[^>]*>/g,"")
    );

  }

}


/*
==================================================
SEND MESSAGE
==================================================
*/

function sendMessage() {

  const input =
    document.getElementById("textInput");

  const text =
    input.value.trim();

  if(!text)
    return;

  addMessage(
    text,
    "user",
    false
  );

  input.value = "";

  setTimeout(() => {

    addMessage(
      lang.schemeDescription +
      "<br><br>" +
      lang.apply,
      "assistant"
    );

    showScheme();

  },700);

}


/*
==================================================
VOICE RECOGNITION
==================================================
*/

let recognition = null;

function startListening() {

  const SpeechRecognition =
    window.SpeechRecognition ||
    window.webkitSpeechRecognition;

  if(!SpeechRecognition) {

    alert(
      "Voice recognition is not supported by this browser. Please use Google Chrome."
    );

    return;
  }

  recognition =
    new SpeechRecognition();

  recognition.lang =
    lang.speech;

  recognition.interimResults =
    false;

  recognition.maxAlternatives =
    1;

  const mic =
    document.getElementById("micButton");

  const status =
    document.getElementById("voiceStatus");

  mic.classList.add("listening");

  status.innerText =
    "🎧 ...";

  recognition.start();


  recognition.onresult =
    function(event) {

      const transcript =
        event.results[0][0].transcript;

      document.getElementById(
        "textInput"
      ).value = transcript;

      status.innerText =
        "✓";

      mic.classList.remove(
        "listening"
      );

      sendMessage();

    };


  recognition.onerror =
    function() {

      mic.classList.remove(
        "listening"
      );

      status.innerText =
        lang.voice;

    };


  recognition.onend =
    function() {

      mic.classList.remove(
        "listening"
      );

    };

}


/*
==================================================
TEXT TO SPEECH
==================================================
*/

function speak(text) {

  if(!("speechSynthesis" in window))
    return;

  window.speechSynthesis.cancel();

  const utterance =
    new SpeechSynthesisUtterance(text);

  utterance.lang =
    lang.speech;

  utterance.rate =
    0.85;

  utterance.pitch =
    1;

  window.speechSynthesis.speak(
    utterance
  );

}


/*
==================================================
SHOW SCHEME
==================================================
*/

function showScheme() {

  const card =
    document.getElementById(
      "schemeCard"
    );

  card.classList.remove(
    "hidden"
  );

  card.scrollIntoView({
    behavior:"smooth"
  });

}


/*
==================================================
SHOW STEPS
==================================================
*/

function showSteps() {

  const card =
    document.getElementById(
      "stepsCard"
    );

  card.classList.remove(
    "hidden"
  );

  card.scrollIntoView({
    behavior:"smooth"
  });

  speak(
    lang.stepsDescription
  );

}


/*
==================================================
GOVERNMENT WEBSITE
==================================================
*/

function openGovernmentSite() {

  /*
   * IMPORTANT:
   * Replace this with the official
   * scheme/service URL you choose.
   */

  window.open(
    "https://www.india.gov.in/",
    "_blank"
  );

}


/*
==================================================
COMPLETE
==================================================
*/

function completeApplication() {

  const card =
    document.getElementById(
      "successCard"
    );

  card.classList.remove(
    "hidden"
  );

  card.scrollIntoView({
    behavior:"smooth"
  });

  speak(
    lang.successText
  );

}


/*
==================================================
INITIALIZE
==================================================
*/

updateUI();

</script>

</body>
</html>