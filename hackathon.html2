<!DOCTYPE html>
<html>
  <head>
    <title>Hello, World!</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sakhi AI - Indian Language Government Assistant</title>

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  font-family:
    Arial,
    "Noto Sans",
    "Noto Sans Devanagari",
    "Noto Sans Tamil",
    "Noto Sans Telugu",
    "Noto Sans Kannada",
    "Noto Sans Malayalam",
    sans-serif;
}

body {
  background: #f7f8fc;
  color: #202124;
  min-height: 100vh;
}

header {
  background: linear-gradient(135deg,#673de6,#9146ff);
  color: white;
  padding: 16px 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  box-shadow: 0 3px 15px rgba(0,0,0,.15);
}

.logo {
  font-size: 23px;
  font-weight: bold;
}

.language-box select {
  padding: 9px 12px;
  border-radius: 10px;
  border: none;
  font-size: 14px;
  cursor: pointer;
}

.container {
  width: 100%;
  max-width: 900px;
  margin: auto;
  padding: 30px 18px 80px;
}

.hero {
  text-align: center;
  margin-bottom: 25px;
}

.hero-icon {
  font-size: 60px;
  margin-bottom: 10px;
}

.hero h1 {
  color: #4320a8;
  font-size: 32px;
  margin-bottom: 12px;
}

.hero p {
  color: #666;
  line-height: 1.7;
  font-size: 17px;
}

.card {
  background: white;
  border-radius: 22px;
  padding: 25px;
  margin-bottom: 20px;

  box-shadow: 0 5px 25px rgba(0,0,0,.07);
}

.voice-section {
  text-align: center;
  padding: 35px 20px;
}

.mic-button {
  width: 110px;
  height: 110px;

  border-radius: 50%;
  border: none;

  background: #6c3df5;
  color: white;

  font-size: 43px;

  cursor: pointer;

  box-shadow:
    0 8px 25px rgba(108,61,245,.35);

  transition: .2s;
}

.mic-button:hover {
  transform: scale(1.05);
}

.mic-button.listening {
  background: #e53935;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {

  0% {
    box-shadow:
      0 0 0 0 rgba(229,57,53,.5);
  }

  70% {
    box-shadow:
      0 0 0 25px rgba(229,57,53,0);
  }

  100% {
    box-shadow:
      0 0 0 0 rgba(229,57,53,0);
  }

}

.voice-status {
  margin-top: 18px;
  color: #666;
}

.input-row {
  display: flex;
  gap: 10px;
  margin-top: 25px;
}

.input-row input {
  flex: 1;

  padding: 15px;

  border: 1px solid #ddd;
  border-radius: 14px;

  font-size: 16px;
}

.send-btn {
  padding: 0 22px;

  border: none;
  border-radius: 14px;

  background: #6c3df5;
  color: white;

  cursor: pointer;
  font-size: 16px;
}

.chat {
  max-height: 450px;
  overflow-y: auto;
}

.message {
  display: flex;
  margin: 12px 0;
}

.message.user {
  justify-content: flex-end;
}

.bubble {
  max-width: 80%;
  padding: 14px 17px;

  border-radius: 18px;

  line-height: 1.7;
  font-size: 16px;
}

.assistant .bubble {
  background: #f0ecff;
  border-bottom-left-radius: 5px;
}

.user .bubble {
  background: #6c3df5;
  color: white;
  border-bottom-right-radius: 5px;
}

.scheme h2,
.steps-card h2 {
  margin-bottom: 18px;
  color: #4320a8;
}

.scheme {
  border: 2px solid #eee;
  border-radius: 18px;
  padding: 20px;
}

.scheme-item {
  display: flex;
  gap: 14px;

  padding: 15px 0;

  border-bottom: 1px solid #eee;
}

.scheme-item:last-child {
  border-bottom: none;
}

.scheme-icon {
  font-size: 27px;
}

.primary {
  width: 100%;

  padding: 15px;
  margin-top: 18px;

  background: #6c3df5;
  color: white;

  border: none;
  border-radius: 13px;

  font-size: 17px;
  font-weight: bold;

  cursor: pointer;
}

.secondary {
  background: #eee9ff;
  color: #4d28c9;

  border: none;
  border-radius: 12px;

  padding: 12px 16px;

  cursor: pointer;

  margin-top: 10px;
}

.steps {
  margin-top: 10px;
}

.step {
  display: flex;
  gap: 15px;

  padding: 18px 0;

  border-bottom: 1px solid #eee;
}

.step-number {
  min-width: 38px;
  height: 38px;

  border-radius: 50%;

  background: #6c3df5;
  color: white;

  display: flex;
  align-items: center;
  justify-content: center;

  font-weight: bold;
}

.step-content h4 {
  margin-bottom: 6px;
}

.step-content p {
  color: #666;
  line-height: 1.6;
}

.success {
  text-align: center;
  padding: 30px;
}

.success-icon {
  font-size: 65px;
  margin-bottom: 15px;
}

.hidden {
  display: none;
}

footer {
  text-align: center;
  padding: 25px;
  color: #888;
  font-size: 13px;
}

@media(max-width:600px) {

  .hero h1 {
    font-size: 26px;
  }

  .input-row {
    flex-direction: column;
  }

  .send-btn {
    padding: 14px;
  }

  .bubble {
    max-width: 90%;
  }

}
</style>
</head>


<body>

<header>

  <div class="logo">
    🌸 Sakhi AI
  </div>

  <div class="language-box">

    <select id="languageSelect"
            onchange="changeLanguage()">

    </select>

  </div>

</header>


<div class="container">

  <section class="hero">

    <div class="hero-icon">
      👩‍💻
    </div>

    <h1 id="title"></h1>

    <p id="subtitle"></p>

  </section>


  <!-- VOICE -->

  <div class="card voice-section">

    <button
      id="micButton"
      class="mic-button"
      onclick="startListening()">

      🎙️

    </button>

    <div
      id="voiceStatus"
      class="voice-status">
    </div>


    <div class="input-row">

      <input
        id="textInput"
        type="text">

      <button
        class="send-btn"
        onclick="sendMessage()"
        id="sendButton">
      </button>

    </div>

  </div>


  <!-- CHAT -->

  <div class="card">

    <div id="chat" class="chat"></div>

  </div>


  <!-- SCHEME -->

  <div
    id="schemeCard"
    class="card hidden">

    <h2 id="schemeTitle"></h2>

    <div class="scheme">

      <h3 id="schemeName"></h3>

      <p id="schemeDescription"></p>


      <div class="scheme-item">

        <div class="scheme-icon">
          👩
        </div>

        <div>
          <b id="whoTitle"></b>
          <br>
          <span id="whoText"></span>
        </div>

      </div>


      <div class="scheme-item">

        <div class="scheme-icon">
          💰
        </div>

        <div>
          <b id="benefitTitle"></b>
          <br>
          <span id="benefitText"></span>
        </div>

      </div>


      <div class="scheme-item">

        <div class="scheme-icon">
          📄
        </div>

        <div>
          <b id="documentTitle"></b>
          <br>
          <span id="documentText"></span>
        </div>

      </div>


      <button
        class="primary"
        onclick="showSteps()"
        id="applyButton">
      </button>

    </div>

  </div>


  <!-- STEPS -->

  <div
    id="stepsCard"
    class="card hidden steps-card">

    <h2 id="stepsTitle"></h2>

    <p id="stepsDescription"></p>


    <div class="steps">

      <div class="step">

        <div class="step-number">1</div>

        <div class="step-content">

          <h4 id="step1Title"></h4>

          <p id="step1Text"></p>

          <button
            class="secondary"
            onclick="openGovernmentSite()"
            id="websiteButton">
          </button>

        </div>

      </div>


      <div class="step">

        <div class="step-number">2</div>

        <div class="step-content">

          <h4 id="step2Title"></h4>

          <p id="step2Text"></p>

        </div>

      </div>


      <div class="step">

        <div class="step-number">3</div>

        <div class="step-content">

          <h4 id="step3Title"></h4>

          <p id="step3Text"></p>

        </div>

      </div>


      <div class="step">

        <div class="step-number">4</div>

        <div class="step-content">

          <h4 id="step4Title"></h4>

          <p id="step4Text"></p>

        </div>

      </div>


      <div class="step">

        <div class="step-number">5</div>

        <div class="step-content">

          <h4 id="step5Title"></h4>

          <p id="step5Text"></p>

        </div>

      </div>

    </div>


    <button
      class="primary"
      onclick="completeApplication()"
      id="completeButton">
    </button>

  </div>


  <!-- SUCCESS -->

  <div
    id="successCard"
    class="card hidden">

    <div class="success">

      <div class="success-icon">
        🎉
      </div>

      <h2 id="successTitle"></h2>

      <p id="successText"></p>

    </div>

  </div>

</div>


<footer>
  Sakhi AI • Digital Inclusion • HackArena
</footer>



<script>

/*
==================================================
LANGUAGES
==================================================
*/

const languages = {

  hi: {
    name:"हिन्दी",
    speech:"hi-IN",

    title:"आपका सरकारी सहायता साथी",
    subtitle:"सरकारी योजनाओं के बारे में जानने के लिए बोलें या लिखें।",

    voice:"बोलना शुरू करने के लिए माइक दबाएं",
    placeholder:"यहां लिखें...",
    send:"भेजें",

    welcome:"नमस्ते 👋<br><br>मैं <b>Sakhi AI</b> हूं।<br>मैं आपको सरकारी योजनाओं और सेवाओं को आसानी से समझने और इस्तेमाल करने में मदद करूंगा।<br><br>क्या आपको सरकारी सहायता चाहिए?",

    schemeTitle:"🌱 आपके लिए सरकारी योजना",
    schemeName:"महिलाओं के लिए सरकारी सहायता",
    schemeDescription:"आपकी जानकारी के आधार पर यह सरकारी सेवा आपके लिए उपयुक्त हो सकती है।",

    whoTitle:"किसके लिए?",
    whoText:"पात्र महिलाओं के लिए।",

    benefitTitle:"क्या मिलेगा?",
    benefitText:"सरकार द्वारा दी जाने वाली योजना की सहायता।",

    documentTitle:"जरूरी दस्तावेज",
    documentText:"पहचान पत्र, बैंक खाता आदि।",

    apply:"👉 आवेदन कैसे करें?",

    stepsTitle:"📝 आइए आवेदन करें",
    stepsDescription:"चिंता न करें। मैं आपको हर कदम पर मदद करूंगा।",

    step1Title:"सरकारी वेबसाइट खोलें",
    step1Text:"नीचे दिए गए बटन को दबाएं।",
    step2Title:"आवेदन चुनें",
    step2Text:"'Apply' या 'आवेदन करें' बटन चुनें।",
    step3Title:"अपनी जानकारी भरें",
    step3Text:"नाम, मोबाइल नंबर और मांगी गई जानकारी भरें।",
    step4Title:"दस्तावेज जमा करें",
    step4Text:"जरूरी दस्तावेजों की फोटो अपलोड करें।",
    step5Title:"आवेदन जमा करें",
    step5Text:"जानकारी जांचकर Submit दबाएं।",

    website:"🌐 सरकारी वेबसाइट खोलें",
    complete:"✅ मैंने पूरा कर लिया",

    successTitle:"बहुत अच्छा! 🎉",
    successText:"आपने प्रक्रिया पूरी कर ली है। अब आप ऐसी सरकारी सेवाओं को खुद इस्तेमाल कर सकते हैं।"
  },


  ta: {
    name:"தமிழ்",
    speech:"ta-IN",

    title:"உங்கள் அரசு உதவி நண்பர்",
    subtitle:"அரசு திட்டங்களைப் பற்றி தெரிந்துகொள்ள பேசுங்கள் அல்லது எழுதுங்கள்.",

    voice:"பேச தொடங்க மைக்கை அழுத்துங்கள்",
    placeholder:"இங்கே எழுதுங்கள்...",
    send:"அனுப்பு",

    welcome:"வணக்கம் 👋<br><br>நான் <b>Sakhi AI</b>.<br>அரசு திட்டங்கள் மற்றும் சேவைகளை எளிதாக புரிந்துகொள்ளவும் பயன்படுத்தவும் நான் உதவுகிறேன்.<br><br>உங்களுக்கு அரசு உதவி வேண்டுமா?",

    schemeTitle:"🌱 உங்களுக்கு பொருந்தக்கூடிய அரசு திட்டம்",
    schemeName:"பெண்களுக்கான அரசு உதவி",
    schemeDescription:"உங்கள் தகவல்களின் அடிப்படையில் இந்த அரசு சேவை உங்களுக்கு பொருந்தக்கூடும்.",

    whoTitle:"யாருக்கு?",
    whoText:"தகுதியான பெண்களுக்கு.",

    benefitTitle:"என்ன கிடைக்கும்?",
    benefitText:"அரசு வழங்கும் திட்ட உதவி.",

    documentTitle:"தேவையான ஆவணங்கள்",
    documentText:"அடையாள அட்டை, வங்கி கணக்கு போன்றவை.",

    apply:"👉 எப்படி விண்ணப்பிப்பது?",

    stepsTitle:"📝 படிப்படியாக விண்ணப்பிப்போம்",
    stepsDescription:"கவலைப்பட வேண்டாம். ஒவ்வொரு படியாகவும் நான் உங்களுக்கு உதவுகிறேன்.",

    step1Title:"அரசு இணையதளத்தை திறக்கவும்",
    step1Text:"கீழே உள்ள பொத்தானை அழுத்தவும்.",
    step2Title:"விண்ணப்பத்தை தேர்வு செய்யவும்",
    step2Text:"'Apply' அல்லது 'விண்ணப்பிக்க' என்பதை தேர்வு செய்யவும்.",
    step3Title:"உங்கள் தகவலை உள்ளிடவும்",
    step3Text:"பெயர், மொபைல் எண் மற்றும் கேட்கப்படும் தகவல்களை உள்ளிடவும்.",
    step4Title:"ஆவணங்களை சமர்ப்பிக்கவும்",
    step4Text:"தேவையான ஆவணங்களின் புகைப்படங்களை பதிவேற்றவும்.",
    step5Title:"விண்ணப்பத்தை சமர்ப்பிக்கவும்",
    step5Text:"தகவல்களை சரிபார்த்து Submit என்பதை அழுத்தவும்.",

    website:"🌐 அரசு இணையதளத்தை திறக்கவும்",
    complete:"✅ நான் முடித்துவிட்டேன்",

    successTitle:"மிகவும் நல்லது! 🎉",
    successText:"நீங்கள் செயல்முறையை முடித்துவிட்டீர்கள். இனி இதுபோன்ற அரசு சேவைகளை நீங்களே பயன்படுத்தலாம்."
  },


  te: {
    name:"తెలుగు",
    speech:"te-IN",

    title:"మీ ప్రభుత్వ సహాయ స్నేహితుడు",
    subtitle:"ప్రభుత్వ పథకాల గురించి తెలుసుకోవడానికి మాట్లాడండి లేదా టైప్ చేయండి.",

    voice:"మాట్లాడటం ప్రారంభించడానికి మైక్ నొక్కండి",
    placeholder:"ఇక్కడ టైప్ చేయండి...",
    send:"పంపండి",

    welcome:"నమస్కారం 👋<br><br>నేను <b>Sakhi AI</b>.<br>ప్రభుత్వ పథకాలు మరియు సేవలను సులభంగా అర్థం చేసుకోవడానికి నేను మీకు సహాయం చేస్తాను.<br><br>మీకు ప్రభుత్వ సహాయం కావాలా?",

    schemeTitle:"🌱 మీకు సరిపోయే ప్రభుత్వ పథకం",
    schemeName:"మహిళల కోసం ప్రభుత్వ సహాయం",
    schemeDescription:"మీ సమాచారం ఆధారంగా ఈ ప్రభుత్వ సేవ మీకు సరిపోవచ్చు.",

    whoTitle:"ఎవరికి?",
    whoText:"అర్హత ఉన్న మహిళలకు.",

    benefitTitle:"ఏమి లభిస్తుంది?",
    benefitText:"ప్రభుత్వ పథకం ద్వారా సహాయం.",

    documentTitle:"అవసరమైన పత్రాలు",
    documentText:"గుర్తింపు పత్రం, బ్యాంక్ ఖాతా మొదలైనవి.",

    apply:"👉 ఎలా దరఖాస్తు చేయాలి?",

    stepsTitle:"📝 దశలవారీగా దరఖాస్తు చేద్దాం",
    stepsDescription:"చింతించకండి. ప్రతి దశలో నేను మీకు సహాయం చేస్తాను.",

    step1Title:"ప్రభుత్వ వెబ్‌సైట్ తెరవండి",
    step1Text:"క్రింది బటన్‌ను నొక్కండి.",
    step2Title:"దరఖాస్తును ఎంచుకోండి",
